{% set infoFilters = manager.infoFilters %}
{% if infoFilters|length %}
{% set activeFilters = manager.request.filters %}
{% if activeFilters|length > 0 %}
<div class="row collapse show" data-grid-code="{{ manager.definition.code }}" data-grid-role="filter-summary">
    <div class="col-12 mb-2">
        <b class="me-2">{{ 'spipu.ui.grid.filter.filters'|trans }}</b>
        <a class="me-2 text-primary" role="button" title="{{ 'spipu.ui.grid.filter.modify'|trans }}" aria-label="{{ 'spipu.ui.grid.filter.modify'|trans }}" data-grid-code="{{ manager.definition.code }}" data-grid-role="filter-open"><i class="fa-solid fa-filter"></i></a>
        <a class="me-2 text-danger" role="button" title="{{ 'spipu.ui.grid.filter.clean'|trans }}" aria-label="{{ 'spipu.ui.grid.filter.clean'|trans }}" data-grid-code="{{ manager.definition.code }}" data-grid-role="filter-clean"><i class="fa-solid fa-trash-can"></i></a>
{% for column in infoFilters %}
{%     if activeFilters[column.code] is defined %}
{%         if column.filter.isRange %}
{%             for rangeKey, rangeSymbol in {'from': '≥', 'to': '≤'} %}
{%                 set rangeValue = manager.request.filter(column.code, rangeKey) %}
{%                 if rangeValue != '' %}
        <span class="badge text-bg-info fw-normal me-1">{{ column.name|trans }} <b>{{ rangeSymbol }} {{ rangeValue }}</b></span>
{%                 endif %}
{%             endfor %}
{%         else %}
{%             set values = column.filter.isMultipleValues ? manager.request.multipleValuesFilter(column.code) : [manager.request.filter(column.code)] %}
{%             set options = column.type.options ? column.type.options.options : [] %}
{%             set labels = [] %}
{%             for value in values %}
{%                 set label = options[value] ?? value %}
{%                 if options[value] is defined and column.type.translate %}{% set label = label|trans %}{% endif %}
{%                 set labels = labels|merge([label]) %}
{%             endfor %}
{%             set valueSymbol = (column.filter.exactValue or column.type.type == 'select') ? '=' : '∋' %}
        <span class="badge text-bg-info fw-normal me-1">{{ column.name|trans }} <b>{{ valueSymbol }} {{ labels|join(', ') }}</b></span>
{%         endif %}
{%     endif %}
{% endfor %}
    </div>
</div>
{% endif %}
<div class="row collapse" data-grid-code="{{ manager.definition.code }}" data-grid-role="filter-collapse">
    <div class="col-12 mb-2">
        <div class="card">
            <div class="card-header">
                <b>{{ 'spipu.ui.grid.filter.title'|trans }}</b>
            </div>
            <div class="card-body">
                <form method="get" action="{{ manager.currentResetUrl }}" onsubmit="return true;" data-grid-code="{{ manager.definition.code }}" data-grid-role="filter-form">
                    <input type="hidden" name="qs[field]" value="" />
                    <div class="col-12">
                        <div class="row mb-2">
{% for column in infoFilters %}
{%     if column.filter.isRange %}
{%         include column.filter.templateFilter with {
                'manager':     manager,
                'column':      column,
                'label':       (column.name|trans) ~ ' - ' ~ ('spipu.ui.grid.filter.from'|trans),
                'input_id':    'filter_' ~ column.code ~ '_from',
                'input_name':  'fl[' ~ column.code ~ '][from]',
                'input_value': manager.request.filter(column.code, 'from')
            } %}
{%         include column.filter.templateFilter with {
                'manager':     manager,
                'column':      column,
                'label':       (column.name|trans) ~ ' - ' ~ ('spipu.ui.grid.filter.to'|trans),
                'input_id':    'filter_' ~ column.code ~ '_to',
                'input_name':  'fl[' ~ column.code ~ '][to]',
                'input_value': manager.request.filter(column.code, 'to')
            } %}
{%     elseif column.filter.isMultipleValues %}
{%         include column.filter.templateFilter with {
                'manager':     manager,
                'column':      column,
                'label':       column.name|trans,
                'input_id':    'filter_' ~ column.code,
                'input_name':  'fl[' ~ column.code ~ ']',
                'input_values': manager.request.multipleValuesFilter(column.code)
            } %}
{%     else %}
{%         include column.filter.templateFilter with {
                'manager':     manager,
                'column':      column,
                'label':       column.name|trans,
                'input_id':    'filter_' ~ column.code,
                'input_name':  'fl[' ~ column.code ~ ']',
                'input_value': manager.request.filter(column.code)
            } %}
{%     endif %}
{% endfor %}
                        </div>
                    </div>
                    <div class="col-12 mb-2 mt-2">
                        <div class="row">
                            <div class="col-12 col-sm-6">
                                <button type="button" class="btn btn-outline-secondary w-100" data-grid-code="{{ manager.definition.code }}" data-grid-role="filter-cancel"><i class="fa-solid fa-xmark"></i> {{ 'spipu.ui.grid.filter.clean'|trans }}</button>
                            </div>
                            <div class="col-12 col-sm-6">
                                <button type="submit" class="btn btn-primary w-100" data-grid-code="{{ manager.definition.code }}" data-grid-role="filter-submit"><i class="fa-solid fa-magnifying-glass"></i> {{ 'spipu.ui.grid.filter.search'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endif %}
