{% use "bootstrap_5_layout.html.twig" %}

{% block file_widget -%}
    {%- set attr = attr|merge({placeholder: 'spipu.ui.field.file.placeholder'|trans}) -%}
    {{- block('form_widget') -}}
{%- endblock %}

{% block integerunit_widget -%}
    <div class="input-group">
        {{- block('integer_widget') -}}
        <span class="input-group-text">{{ unit }}</span>
    </div>
{%- endblock %}

{% block numberunit_widget -%}
    <div class="input-group">
        {{- block('number_widget') -}}
        <span class="input-group-text">{{ unit }}</span>
    </div>
{%- endblock %}
